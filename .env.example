# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Copy the URI from Supabase Project Settings -> Database -> Connection string.
# Use the pooled URI for deployed app traffic and keep sslmode=require.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Bcrypt password hashes for owner and staff (default demo: owner123 / staff123)
OWNER_PASSWORD_HASH="$2a$10$wNqV9b6yRk.W69eXp2gQh.mB6nE1j5F0uO8tZ9aB4vC3dE2fG1hIi"
STAFF_PASSWORD_HASH="$2a$10$7ZqK2p3xJ8vL9m0nR1sT5.uW4yX3z2A1bC0dE9fG8hI7jK6lM5nOo"

# JWT Secret for stateless token signing
JWT_SECRET="bake-and-brew-secret-key-production-cafe-2026"
